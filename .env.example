# Copie este arquivo para .env e preencha com os dados do seu projeto no Supabase
# (Project Settings → API). Sem estas variáveis, o app roda no modo demonstração.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Chave pública "anon": pode ir para o navegador; quem protege os dados é o RLS.
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: endereço público do site, usado no SEO (canonical, sitemap, llms.txt).
# SITE_URL=https://seu-dominio.com.br
