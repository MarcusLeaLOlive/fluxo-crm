# =========================================================
#  .gitignore — Fluxo (React + Vite)
# =========================================================

# ---------- Dependências ----------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins

# ---------- Build e saídas geradas ----------
# Gerados por `npm run build` (robots.txt, sitemap.xml e llms.txt também saem daqui)
dist/
dist-ssr/
build/
*.local

# ---------- Caches de ferramentas ----------
.vite/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ---------- Testes e cobertura ----------
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ---------- Variáveis de ambiente (nunca versionar segredos) ----------
.env
.env.*
!.env.example

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Deploy (pastas locais das plataformas) ----------
.netlify/
.vercel/
.firebase/

# ---------- Editores e IDEs ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Sistema operacional ----------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Arquivos temporários ----------
*.tmp
*.temp
*.bak
